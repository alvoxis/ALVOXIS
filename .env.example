# =========================================================
# ALVOXIS — configuration reference (copy to .env for local
# work; .env is git-ignored). NEVER commit real secrets.
# =========================================================

# ---------------------------------------------------------
# 1. PUBLIC — browser
# The site is plain static files on GitHub Pages (no build
# step), so these two public values live in js/config.js.
# Supabase Dashboard → Project Settings → API Keys.
# ---------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------
# 2. SERVER — Supabase Edge Function secrets
# Set in Supabase Dashboard → Edge Functions → Secrets
# (or: supabase secrets set NAME=value). Never in the browser.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to
# Edge Functions automatically by Supabase.
# ---------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=https://alvoxis.eu
# optional: existing Stripe Prices to use for the gift boxes
# (used only if they charge exactly €49.99 / €59.99 in EUR)
STRIPE_PRICE_MINI=
STRIPE_PRICE_CLASSIC=
# optional: extra allowed browser origins, comma separated
ALLOWED_ORIGINS=

# ---------------------------------------------------------
# 3. DEPLOYMENT — GitHub repository secrets used by
# .github/workflows/supabase-deploy.yml
# ---------------------------------------------------------
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
